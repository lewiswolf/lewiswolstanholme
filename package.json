{
	"name": "lewiswolstanholme",
	"version": "1.4.3",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"@p5-wrapper/react": "^5.0.5",
		"maxmsp-gui": "^2.7.0",
		"p5": "^2.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-router": "^8.5.1",
		"react-syntax-highlighter": "^16.1.2",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"sass-embedded": "^1.108.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@eslint-react/eslint-plugin": "^5.30.2",
		"@eslint/js": "^10.0.1",
		"@prettier/plugin-xml": "^3.4.2",
		"@types/bun": "^1.4.4",
		"@types/p5": "^1.7.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-router": "^5.1.20",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"prettier": "^3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-plugin-compression2": "^2.5.4",
		"vite-plugin-svgr": "^5.2.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"fsevents"
	],
	"scripts": {
		"build": "tsc && vite build",
		"dev": "vite --host",
		"preview": "vite preview",
		"format": "biome format --write ; prettier --write ./**/*.svg",
		"test": "tsc ; biome lint ; eslint ."
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"endOfLine": "lf",
		"htmlWhitespaceSensitivity": "strict",
		"jsxSingleQuote": true,
		"plugins": [
			"@prettier/plugin-xml"
		],
		"printWidth": 125,
		"quoteProps": "as-needed",
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"trailingComma": "all",
		"useTabs": true,
		"xmlQuoteAttributes": "single",
		"xmlSortAttributesByKey": true,
		"xmlWhitespaceSensitivity": "preserve"
	}
}
